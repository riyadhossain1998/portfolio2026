{#- Shared page shell: head, marker sprite, nav, footer. `nav` in front
    matter marks the current section: "home", "work" or "about". -#}
<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>{{ (pageTitle or (title + " | Riyad Hossain")) | e }}</title>
  <meta name="theme-color" content="#A7C8EA">
  <link rel="preconnect" href="https://fonts.googleapis.com">
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
  <link href="https://fonts.googleapis.com/css2?family=Azeret+Mono:wght@400..500&family=Gochi+Hand&family=Piazzolla:ital,opsz,wght@0,8..30,400..600;1,8..30,400..600&display=swap" rel="stylesheet">
  <link rel="stylesheet" href="style.css">
{%- if nav != "home" %}
  <link rel="stylesheet" href="pages.css">
{%- endif %}
  <script>document.documentElement.className = 'js';</script>
</head>
<body>

  <!-- =============================================
       MARKER SPRITE
       Two nodes and an edge: the thesis of the work at 1em. Used for
       the wordmark, the current page indicator and section markers.
       ============================================= -->
  <svg class="sprite" aria-hidden="true" focusable="false">
    <symbol id="m-node" viewBox="0 0 16 16">
      <path d="M5.3 6.2 10.7 9.8"/>
      <circle cx="3.7" cy="4.9" r="2.5"/>
      <circle cx="12.3" cy="11.1" r="2.5"/>
    </symbol>
  </svg>
{% set mark %}<svg class="ic" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><use href="#m-node"/></svg>{% endset %}
{%- set base = "" if nav == "home" else "/" %}
  <nav class="nav{% if nav != 'home' %} scrolled{% endif %}" id="nav">
    <a href="/" class="nav-logo">{{ mark | safe }}<span class="logo-full">Riyad Hossain</span><span class="logo-short">RH</span></a>
    <div class="nav-links">
      <a href="{{ base }}#work"{% if nav == "work" %} class="active">{{ mark | safe }}{% else %}>{% endif %}Work</a>
      <a href="about.html"{% if nav == "about" %} class="active">{{ mark | safe }}{% else %}>{% endif %}About</a>
      <a href="{{ base }}#contact">Contact</a>
    </div>
    <button class="nav-menu-toggle" id="menu-toggle" aria-label="Toggle menu" aria-expanded="false" aria-controls="mobile-menu">
      <span></span><span></span>
    </button>
  </nav>

  <!-- Mobile Menu -->
  <div class="mobile-menu" id="mobile-menu">
    <div class="mobile-menu-links">
      <a href="{{ base }}#work">Work</a>
      <a href="about.html">About</a>
      <a href="{{ base }}#contact">Contact</a>
    </div>
  </div>

{{ content | safe }}

  <footer class="footer">
    <div class="footer-inner">
      <span class="footer-logo">Riyad Hossain</span>
      <nav class="footer-links">
        <a href="mailto:riyadhossain112357@gmail.com">Email</a>
        <a href="https://www.linkedin.com/in/riyad-hossain-30773914b" target="_blank" rel="noopener">LinkedIn</a>
        <a href="https://github.com/riyadhossain1998" target="_blank" rel="noopener">GitHub</a>
      </nav>
      <p class="footer-copy">&copy; 2026 Riyad Hossain. Designed with care in Calgary.</p>
    </div>
  </footer>

  <script src="main.js"></script>
</body>
</html>
