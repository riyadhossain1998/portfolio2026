  <!-- =============================================
       HERO
       ============================================= -->
  <header class="hero" id="hero">
    <div class="hero-inner">
      <p class="hero-eyebrow"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><use href="#m-node"/></svg>UX Designer &amp; Client Success Specialist</p>
      <h1 class="hero-title">
        <div><span class="word"><span class="word-inner">I</span></span>&nbsp;<span class="word"><span class="word-inner">design</span></span>&nbsp;<span class="word"><span class="word-inner">products</span></span>&nbsp;<span class="word"><span class="word-inner">and</span></span></div>
        <div><span class="word"><span class="word-inner">I</span></span>&nbsp;<span class="word"><span class="word-inner">help</span></span>&nbsp;<span class="word"><span class="word-inner">people</span></span>&nbsp;<span class="word"><span class="word-inner">actually</span></span></div>
        <div><span class="word"><span class="word-inner"><em>use</em></span></span>&nbsp;<span class="word"><span class="word-inner">them.</span></span></div>
      </h1>
      <p class="hero-sub">I spent over two years in client success at ActiveDEMAND, onboarding clients, working Tier 2 tickets and building workflows, landing pages and emails. As a result, I design with the people on the other end of the screen in mind, and I build a lot of what I design too.</p>
      <div class="hero-cta">
        <a href="#work" class="btn btn-primary">View My Work</a>
        <a href="about.html" class="btn btn-ghost">About Me</a>
      </div>
    </div>
    <div class="hero-scroll-hint">
      <div class="scroll-line"></div>
    </div>
  </header>

  <!-- =============================================
       WORK / CASE STUDIES
       ============================================= -->
  <section id="work" class="work">
    <div class="section-header reveal">
      <h2 class="section-title">Case Studies</h2>
      <span class="section-label"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><use href="#m-node"/></svg>Selected Work</span>
    </div>

    <div class="project-list">
{%- for p in collections.caseStudies %}
{%- set d = p.data %}

      <a href="{{ p.url | localPath }}" class="project-item reveal">
        <div class="project-image">
{%- if d.thumb %}
          {% include "thumbs/" + d.thumb + ".svg" %}
{%- elif d.cover and d.cover.src %}
          <img src="{{ d.cover.src | localPath | e }}" alt="" loading="lazy">
{%- endif %}
        </div>
        <div class="project-info">
          <span class="project-number">{{ loop.index | pad2 }}</span>
          <span class="project-category">{{ d.category | e }}</span>
          <h3 class="project-name">{{ (d.listTitle or d.title) | e }}</h3>
          <p class="project-desc">{{ d.summary | e }}</p>
          <div class="project-tags">
{%- for t in d.labels %}
            <span class="project-tag">{{ t | e }}</span>
{%- endfor %}
          </div>
          <span class="project-link">View Case Study <svg width="16" height="16" viewBox="0 0 16 16" fill="none"><path d="M3 8h10M9 4l4 4-4 4" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round"/></svg></span>
        </div>
      </a>
{%- endfor %}
    </div>
  </section>

  <!-- =============================================
       ABOUT TEASER
       ============================================= -->
  <section class="about-teaser">
    <div class="about-teaser-inner reveal">
      <div class="about-teaser-avatar">
        <img src="images/intro/IMG_0173.jpg" alt="Riyad Hossain" loading="lazy">
      </div>
      <div class="about-teaser-content">
        <h2 class="section-title">Communication meets creativity.</h2>
        <span class="section-label"><svg class="ic" viewBox="0 0 16 16" aria-hidden="true" focusable="false"><use href="#m-node"/></svg>A Little About Me</span>
        <p>I completed my Bachelor of Arts in Communication &amp; Culture at the University of Calgary at the end of Fall 2022, with specializations in Computer Science and Visual Studies. My time at ActiveDEMAND, a marketing automation platform, ran from May 2024 to July 2026, and on the side I've taken on freelance UX, web and graphic design work.</p>
        <a href="about.html" class="btn btn-primary">More About Me</a>
      </div>
    </div>
  </section>

